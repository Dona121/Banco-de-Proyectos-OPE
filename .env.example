# Plantilla de variables de entorno. Copiar a `proyectos/.env` y rellenar.
#
#   cp .env.example proyectos/.env
#
# `load_dotenv()` se llama SIN ruta, así que busca desde el directorio actual:
# los comandos hay que correrlos desde `proyectos/`, no desde la raíz. Una
# variable exportada en la shell gana sobre el archivo.
# La referencia completa, con los por qué, está en CLAUDE.md.

# --- Obligatorias ----------------------------------------------------------- #

# Sin esto la aplicación no arranca.
SECRET_KEY=

# Session pooler de Supabase. El host directo db.<ref>.supabase.co resuelve solo
# por IPv6; el transaction pooler (:6543) cuelga operaciones largas.
# Si se deja vacía, se usa SQLite local (proyectos/db.sqlite3).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Almacenamiento de los documentos subidos. Si el endpoint queda vacío, boto3 se
# va a la AWS real y TODAS las subidas y descargas fallan.
SUPABASE_S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# --- Opcionales (valor por omisión entre paréntesis) ------------------------ #

# (documentos) Bucket de Supabase Storage.
SUPABASE_BUCKET=

# (us-east-1)
SUPABASE_S3_REGION=

# (1) Ponerlo en 0 para desarrollo local por HTTP: con las cookies marcadas
# Secure no se puede ni iniciar sesión, y la redirección a HTTPS entra en bucle.
HTTPS_ESTRICTO=0

# (0) DEBUG=1 solo en local. También cambia los estáticos al almacenamiento
# plano, así que deja de hacer falta `collectstatic` para trabajar.
DEBUG=

# (*) Hosts admitidos, separados por comas.
ALLOWED_HOSTS=

# (vacío) Orígenes extra de confianza para CSRF: "esquema://host", sin barra
# final. Solo hacen falta para orígenes DISTINTOS del propio.
CSRF_TRUSTED_ORIGINS=

# (3600) Subir a 31536000 cuando se verifique que HTTPS va estable. Cuidado: el
# navegador recuerda la cabecera todo ese tiempo y no se le puede retirar.
SECURE_HSTS_SECONDS=

# (INFO) Nivel del logger `django`, que escribe en la salida estándar.
LOG_LEVEL=
